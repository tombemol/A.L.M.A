generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductIdentifierType {
  EAN
  UPC
  MANUFACTURER
  INTERNAL_BARCODE
  QR
  OTHER
}

enum StorageLocationKind {
  AISLE
  RACK
  SHELF
  POSITION
}

enum OccupancyMode {
  DEDICATED
  SHARED
}

enum InventoryTrackingMode {
  NONE
  LOT
  LOT_EXPIRY
  SERIAL
  SERIAL_EXPIRY
}

enum StockMovementType {
  ENTRY
  WITHDRAWAL
  RETURN
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INVENTORY_GAIN
  INVENTORY_LOSS
}

model User {
  id             String          @id @default(cuid())
  employeeCode   String?         @unique
  username       String?         @unique
  displayName    String
  pinHash        String?
  passwordHash   String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          UserRole[]
  sessions       AuthSession[]
  stockMovements StockMovement[]
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  createdAt DateTime         @default(now())
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  parentId  String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
}

model UnitOfMeasure {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  symbol        String
  allowsDecimal Boolean                 @default(false)
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  baseProducts  Product[]               @relation("ProductBaseUnit")
  conversions   ProductUnitConversion[]
}

model Product {
  id                 String                  @id @default(cuid())
  sku                String                  @unique
  name               String
  description        String?
  categoryId         String
  baseUnitId         String
  manufacturer       String?
  trackingMode       InventoryTrackingMode   @default(NONE)
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit           UnitOfMeasure           @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  identifiers        ProductIdentifier[]
  conversions        ProductUnitConversion[]
  locations          ProductLocation[]
  inventoryLots      InventoryLot[]
  serialItems        SerialItem[]
  inventoryBalances  InventoryBalance[]
  inventoryValuation InventoryValuation?
  stockMovementItems StockMovementItem[]

  @@index([categoryId])
  @@index([baseUnitId])
  @@index([trackingMode])
}

model ProductIdentifier {
  id              String                @id @default(cuid())
  productId       String
  type            ProductIdentifierType
  value           String
  normalizedValue String                @unique
  label           String?
  createdAt       DateTime              @default(now())
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductUnitConversion {
  id           String        @id @default(cuid())
  productId    String
  unitId       String
  factorToBase Decimal       @db.Decimal(18, 6)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit         UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([productId, unitId])
  @@index([unitId])
}

model Warehouse {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  locations        StorageLocation[]
  productLocations ProductLocation[]
}

model StorageLocation {
  id                    String              @id @default(cuid())
  warehouseId           String
  parentId              String?
  kind                  StorageLocationKind
  code                  String
  name                  String?
  occupancyMode         OccupancyMode?
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  warehouse             Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent                StorageLocation?    @relation("StorageLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              StorageLocation[]   @relation("StorageLocationTree")
  productLocations      ProductLocation[]
  inventoryBalances     InventoryBalance[]
  stockMovementItemsFrom StockMovementItem[] @relation("MovementFromLocation")
  stockMovementItemsTo   StockMovementItem[] @relation("MovementToLocation")

  @@unique([warehouseId, code])
  @@index([warehouseId, kind])
  @@index([parentId])
}

model ProductLocation {
  id          String          @id @default(cuid())
  productId   String
  warehouseId String
  locationId  String
  isPrimary   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location    StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([locationId])
}

model InventoryLot {
  id            String              @id @default(cuid())
  productId     String
  lotCode       String
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  balances      InventoryBalance[]
  movementItems StockMovementItem[]

  @@unique([productId, lotCode])
  @@index([expiresAt])
}

model SerialItem {
  id            String              @id @default(cuid())
  productId     String
  serialNumber  String
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  balances      InventoryBalance[]
  movementItems StockMovementItem[]

  @@unique([productId, serialNumber])
  @@index([expiresAt])
}

model InventoryBalance {
  id           String          @id @default(cuid())
  productId    String
  locationId   String
  lotId        String?
  serialItemId String?
  stockKey     String
  quantity     Decimal         @default(0) @db.Decimal(18, 6)
  updatedAt    DateTime        @updatedAt
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location     StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lot          InventoryLot?   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  serialItem   SerialItem?     @relation(fields: [serialItemId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId, stockKey])
  @@index([productId, locationId])
  @@index([lotId])
  @@index([serialItemId])
}

model InventoryValuation {
  productId       String   @id
  quantity        Decimal  @default(0) @db.Decimal(18, 6)
  averageUnitCost Decimal  @default(0) @db.Decimal(18, 6)
  totalValue      Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model StockMovement {
  id                String             @id @default(cuid())
  type              StockMovementType
  reason            String?
  reference         String?
  performedByUserId String?
  createdAt         DateTime           @default(now())
  performedBy       User?              @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  items             StockMovementItem[]

  @@index([type, createdAt])
  @@index([performedByUserId])
}

model StockMovementItem {
  id             String           @id @default(cuid())
  movementId     String
  productId      String
  fromLocationId String?
  toLocationId   String?
  lotId          String?
  serialItemId   String?
  quantity       Decimal          @db.Decimal(18, 6)
  unitCost       Decimal?         @db.Decimal(18, 6)
  totalCost      Decimal?         @db.Decimal(18, 6)
  createdAt      DateTime         @default(now())
  movement       StockMovement    @relation(fields: [movementId], references: [id], onDelete: Cascade)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation   StorageLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     StorageLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  lot            InventoryLot?    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  serialItem     SerialItem?      @relation(fields: [serialItemId], references: [id], onDelete: Restrict)

  @@index([movementId])
  @@index([productId, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([lotId])
  @@index([serialItemId])
}
